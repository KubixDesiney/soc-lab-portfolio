<!-- Focused PowerShell behavior rule for SOC training. -->
<group name="windows,sysmon,powershell,soc_training,">
  <rule id="100521" level="12">
    <if_sid>100516</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-enc(?:odedcommand)?\s+[A-Za-z0-9+/]{20,}={0,2}\b|frombase64string|downloadstring|invoke-expression|\biex\b|\biwr\b|\birm\b|-windowstyle\s+hidden|-w\s+hidden)</field>
    <description>PowerShell launched with an encoded or commonly obfuscated command pattern.</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>sysmon,powershell,powershell_suspicious,command_execution,</group>
  </rule>
</group>

<!-- Promote high-risk PowerShell script-block patterns for SOC training. -->
<group name="windows,powershell,script_block,soc_training,">
  <rule id="100522" level="12">
    <if_sid>91802</if_sid>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(invoke-expression|\biex\b|downloadstring|downloadfile|frombase64string|net\.webclient|start-bitstransfer|invoke-webrequest|add-mppreference)</field>
    <description>PowerShell script block contains a high-risk execution, download, or defense-evasion pattern.</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1105</id>
    </mitre>
    <group>powershell,script_block,powershell_suspicious,command_execution,</group>
  </rule>
</group>

<!-- Supabase operational telemetry rules for the KubixDesiney-Hub backend. -->
<group name="supabase,application_monitoring,">
  <rule id="100511" level="3">
    <decoded_as>json</decoded_as>
    <field name="source" type="pcre2">supabase</field>
    <description>Supabase operational telemetry event.</description>
    <group>supabase_event,</group>
  </rule>
  <rule id="100512" level="8">
    <if_sid>100511</if_sid>
    <field name="outcome" type="pcre2">^(failure|failed|denied|error)$</field>
    <description>Supabase backend reported an agent or notification failure.</description>
    <group>supabase_failure,application_error,</group>
  </rule>
  <rule id="100513" level="12">
    <if_sid>100511</if_sid>
    <field name="severity" type="pcre2">^(critical|high)$</field>
    <description>Supabase backend reported a high-severity operational event.</description>
    <group>supabase_high_severity,application_error,</group>
  </rule>
</group>

<!-- Fallback for Supabase JSON events decoded by the built-in JSON rule first. -->
<group name="supabase,application_monitoring,">
  <rule id="100514" level="8">
    <if_sid>1002</if_sid>
    <field name="source" type="pcre2">supabase</field>
