<!-- Local rules -->
<group name="local,syslog,sshd,">
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>
</group>

<!-- Keep known Git/Codex documentation copies visible without treating JSON as a dropped executable. -->
<group name="windows,sysmon,soc_training,">
  <rule id="100523" level="3">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\Program Files\\Git\\usr\\bin\\cp\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\AppData\\Local\\Temp\\tmp\.[^\\]+\\docs\\.*\.json$</field>
    <description>Known Git/Codex temporary JSON copy; retain as low-severity telemetry.</description>
    <group>sysmon,soc_training,known_benign,</group>
  </rule>
</group>

